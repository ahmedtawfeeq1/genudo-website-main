# Copy to .env on the server and adjust. Never commit .env.
NEXT_PUBLIC_SITE_URL=https://genudo.ai
# Image tag published by GitHub Actions: latest (main) or the branch name, e.g. feat-value-led-website
IMAGE_TAG=latest
# Host port the container listens on (127.0.0.1 only). 3000 is taken on the production server.
WEB_PORT=3001
FORMS_WEBHOOK_URL=https://automationv2.loop-x.co/webhook/genudo-website-forms
# Optional shared secret; check the X-GenuDo-Signature header in n8n.
FORMS_WEBHOOK_SECRET=
FORMS_CLIENT_IP_HEADER=x-real-ip
FORMS_GLOBAL_PER_MIN=60
